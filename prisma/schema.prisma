generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DishCategory {
  RICE
  NOODLE
  SOUP
  SNACK
  DRINK
  OTHER
}

enum MealTime {
  BREAKFAST
  LUNCH
  DINNER
  LATE_NIGHT
}

model Dish {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  imageUrl    String
  category    DishCategory
  description String?
  spiceLevel  Int          @default(0)
  weight      Int          @default(1)
  isVegetarian Boolean      @default(false)
  priceLevel  Int          @default(1)
  prepTimeMinutes Int       @default(30)
  mealTimes   MealTime[]    @default([DINNER])
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([category])
  @@index([isActive])
  @@index([name])
}
